          ] } }]
        },
        {
          "name": "Globex dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{globex_key}}" }],
            "url": { "raw": "{{base_url}}/api/merchants/{{globex_merchant_id}}/dashboard", "host": ["{{base_url}}"], "path": ["api", "merchants", "{{globex_merchant_id}}", "dashboard"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Cross-tenant: Acme key views Globex's dashboard -> 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{acme_key}}" }],
            "url": { "raw": "{{base_url}}/api/merchants/{{globex_merchant_id}}/dashboard", "host": ["{{base_url}}"], "path": ["api", "merchants", "{{globex_merchant_id}}", "dashboard"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    },
    {
      "name": "6 - Invoices (auditable billing breakdown)",
      "item": [
        {
          "name": "List Orbit Solutions' invoices (overage example)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{acme_key}}" }],
            "url": { "raw": "{{base_url}}/api/subscriptions/{{acme_subscription_orbit_id}}/invoices", "host": ["{{base_url}}"], "path": ["api", "subscriptions", "{{acme_subscription_orbit_id}}", "invoices"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Show Orbit's invoice detail (usage=14935, overage=4935 units)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{acme_key}}" }],
            "url": { "raw": "{{base_url}}/api/invoices/{{acme_invoice_orbit_id}}", "host": ["{{base_url}}"], "path": ["api", "invoices", "{{acme_invoice_orbit_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
